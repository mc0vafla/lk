{
  "font_family": "DepartureMono",
  "font_size": 12,
  "bg_color": "#282828",
  "fg_color": "#d3c6aa",
  "padding_x": 6,
  "padding_y": 6,
  "shell": "fish",
  // Available special escape sequences in actions: \n or \r (Enter), \t (Tab), \b (Backspace), \e (Escape)
  "binds": [
    { "key": "c", "mods": "ctrl+shift", "action": "copy" },
    { "key": "v", "mods": "ctrl+shift", "action": "paste" },
    { "key": "equal", "mods": "ctrl", "action": "font_increase" },
    { "key": "minus", "mods": "ctrl", "action": "font_decrease" },
    { "key": "x", "mods": "alt", "actions": ["u", "\r"] },
    { "key": "z", "mods": "alt", "actions": ["dell", "\r"] },
    { "key": "e", "mods": "alt", "actions": ["nvim ~/.config/nvim/lua/mappings.lua\n"] },
    { "key": "f", "mods": "alt", "actions": ["nvim ~/.config/fish/config.fish\n"] },
    { "key": "d", "mods": "alt", "actions": ["nvim ~/.config/l/config.json\n"] },
    { "key": "r", "mods": "alt", "actions": ["doas nvim /etc/pacman.d/mirrorlist\n"] },
    { "key": "d", "mods": "ctrl+alt", "actions": ["nvim ~/.config/tmux/tmux.conf\n"] },
    { "key": "d", "mods": "shift+alt", "actions": ["nvim ~/.config/niri/modules/keybinds.kdl\n"] },
    { "key": "a", "mods": "alt", "actions": ["upd-grub\n"] },
    { "key": "c", "mods": "alt", "actions": ["gss\n"] },
    { "key": "w", "mods": "alt", "actions": ["na\n"] },
    { "key": "f", "mods": "ctrl", "actions": ["tmux\n"] },
    { "key": "s", "mods": "alt", "actions": ["dua i\n"] }
    { "key": "q", "mods": "alt", "actions": ["h\n"] },
    { "key": "j", "mods": "alt", "actions": [" > /dev/null 2>&1"] }
  ]
}
