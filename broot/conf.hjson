show_status_line: false

terminal_title: "[broot] {git-name}"

date_time_format: %Y/%m/%d %R

show_selection_mark: true

true_colors: true

icon_theme: nerdfonts

special_paths: {
    "trav": {
        show: always
        list: "always",
        sum: "never"
    }
    ".*": { "show": "always" }
}

content_search_max_file_size: 10MB

update_work_dir: true

enable_kitty_keyboard: false

lines_before_match_in_preview: 1
lines_after_match_in_preview: 1

preview_transformers: [ ]

skin: {
    default: "#d3c6aa none"

    tree: "#5c4040 none"

    file: "#d3c6aa none"
    directory: "#e67e80 none bold"
    
    selected_line: "#f2e5bc none"
    
    dates: "#857373 none"
    size: "#857373 none"
    permissions: "#857373 none"
    
    input: "#e67e80 none"
    char_match: "#ff9193 none bold"

    git_status: "#dbbc7f none"
    flag_label: "#e67e80 none"
    flag_value: "#dbbc7f none"
    
    status_normal: "#d3c6aa #201818"
}

verbs: [
    {
        invocation: edit
        key: enter
        shortcut: e
        apply_to: "file"
        execution: "nvim {file}"
        leave_broot: false
    }
    {
        name: "enter_dir"
        key: enter
        mime_filter: "directory"
        internal: "focus"
    }
    {
        key: ctrl-x
        apply_to: "file"
        internal: "open_stay"
    }
    {
        invocation: terminal
        key: ctrl-d
        execution: "$SHELL"
        set_working_dir: true
        leave_broot: false
    }
    {
        key: ctrl-k
        execution: ":line_up"
    }
    {
        key: ctrl-j
        execution: ":line_down"
    }
    {
        key: ctrl-u
        execution: ":page_up"
    }
    {
        key: ctrl-d
        execution: ":page_down"
    }
    {
        key: alt-g
        execution: ":toggle_git_status"
    }
    {
        key: "ctrl-l"
        internal: "open_stay"
    }
    {
        key: "ctrl-h"
        internal: ":back"
    }
    {
        key: "ctrl-w"
        internal: ":escape"
    }
]

imports: [
    verbs.hjson
]
