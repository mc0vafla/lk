{
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 5,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": ["tray"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio"],

    "tray": {
        "icon-size": 16,
        "spacing": 10,
        "show-passive-items": true
    },

    "clock": {
        "format": " {:%H:%M}",
        "format-alt": " {:%Y-%m-%d}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol"
    }
}
