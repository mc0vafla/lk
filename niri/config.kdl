include "./modules/animation.kdl"
include "./modules/keybinds.kdl"
include "./modules/input.kdl"
include "./modules/display.kdl"
include "./modules/layout.kdl"
include "./modules/rules.kdl"
include "./modules/misc.kdl"
include "./modules/autostart.kdl"

gestures {
    hot-corners {
        off
    }
}
recent-windows {
    debounce-ms 750
    open-delay-ms 100
    highlight {
        corner-radius 20
    }
}

overview {
    backdrop-color "#3C3835"
    zoom 0.45
}
screenshot-path "/home/helminth/Pictures/Screenshots/sc%Y-%m-%d %H-%M-%S.png"
