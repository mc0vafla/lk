{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "artix_small",
        "padding": {
            "top": 0
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        {
            "type": "os",
            "key": "OS      ",
            "keyColor": "cyan"
        },
        {
            "type": "kernel",
            "key": "KERNEL  ",
            "keyColor": "cyan"
        },
        {
            "type": "packages",
            "key": "PKGS    ",
            "keyColor": "cyan"
        },
        {
            "type": "wm",
            "key": "WM      ",
            "keyColor": "cyan"
        },
        {
            "type": "terminal",
            "key":  "TERM    ",
            "keyColor": "cyan"
        },
        {
            "type": "initsystem",
            "key":  "INIT    ",
            "keyColor": "cyan"
        },
        {
            "type": "memory",
            "key": "RAM     ",
            "keyColor": "cyan"
        },
        {
            "type": "disk",
            "key":  "DISK    ",
            "keyColor": "cyan"
        },
        {
            "type": "swap",
            "key":  "SWAP    ",
            "keyColor": "cyan"
        },
        {
            "type": "uptime",
            "key": "UPTIME  ",
            "keyColor": "cyan"
        },
        {
            "type": "disk",
            "key": "INSTALL ",
            "folders": "/",
            "format": "{days} days"
        },
        {
            "type": "colors",
            "symbol": "circle",
            "block": {
              "range": [0, 7]
            }
        }
    ]
}
