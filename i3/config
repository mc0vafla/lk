set $mod Mod4
set $alt Mod1

font pango:"DepartureMono" 8

exec_always --no-startup-id sleep 2 && xsetroot -cursor_name left_ptrexec
exec --no-startup-id dunst
exec brightnessctl set 100%
exec feh --bg-fill --no-fehbg ~/Pictures/2.png ~/Pictures/wp15132175-milk-outside-a-bag-of-milk-outside-a-bag-of-milk-wallpapers.webp
exec --no-startup-id xrandr --output eDP-1 --mode 1920x1080 --rate 165.00 --output HDMI-1 --mode 1920x1080 --rate 74.97 --primary --right-of eDP-1
exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id picom
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork
exec --no-startup-id xset s off -dpms
exec --no-startup-id setxkbmap -layout "us,ru" -option "grp:win_space_toggle"
exec --no-startup-id swarp 2875 500

floating_modifier $mod
tiling_drag modifier titlebar
bindsym $mod+Return exec alacritty
bindsym $mod+Shift+Return exec alacritty 
bindsym $mod+q kill
bindsym $mod+v exec --no-startup-id i3-dmenu-desktop --dmenu="dmenu -b -i -nb '#392b2b' -nf '#d3c6aa' -sb '#e680a0' -sf '#2b3339' -fn 'DepartureMono Nerd Font'"

bindsym $alt+f exec ~/.config/i3/start.sh
bindsym $alt+e exec pavucontrol
bindsym $alt+r exec ~/.config/i3/toggle.sh
bindsym $mod+z exec prismlauncher
bindsym $mod+n exec alacritty -e fish -c nvtop
bindsym $mod+r exec helium-browser
bindsym $mod+e exec zen-browser
bindsym $mod+b exec alacritty -e fish -c b
bindsym $mod+k exec alacritty -e fish -c o
bindsym $mod+o exec --no-startup-id alacritty --class cava -e fish -c cava
bindsym $mod+i exec --no-startup-id alacritty --class cute -e fish -c cute
bindsym $alt+1 exec --no-startup-id sh -c "maim -s | xclip -selection clipboard -t image/png && notify-send 'Maim' 'Screenshot been copied' -i screenshot"
bindsym $alt+3 exec --no-startup-id sh -c "maim -u | xclip -selection clipboard -t image/png && notify-send 'Maim' 'Screenshot been copied' -i screenshot"
bindsym $alt+2 exec --no-startup-id sh -c "maim -i \$(xdotool getactivewindow) | xclip -selection clipboard -t image/png && notify-send 'Maim' 'Screenshot been copied' -i screenshot"
bindsym $mod+c exec xarchiver
bindsym $mod+x exec obs

bindsym $mod+a focus left
bindsym $mod+d focus right
bindsym $mod+Shift+a focus left
bindsym $mod+Shift+d focus right
bindsym $mod+w focus up
bindsym $mod+s focus down
bindsym $alt+q resize shrink width 10 px or 10 ppt
bindsym $alt+w resize grow width 10 px or 10 ppt
bindsym $mod+l exec slock

bindsym --whole-window $mod+button4 workspace prev
bindsym --whole-window $mod+button5 workspace next
# bindsym $alt+space [workspace=__focused__] floating toggle
bindsym $alt+a move scratchpad
bindsym $alt+d scratchpad show
bindsym $alt+x exec playerctl next
bindsym $alt+z exec playerctl previous
bindsym $alt+c exec playerctl volume 0.1-
bindsym $alt+v exec playerctl volume 0.1+

bindsym $mod+Ctrl+a move left
bindsym $mod+Ctrl+d move right
bindsym $mod+Ctrl+s move down
bindsym $mod+Ctrl+w move up
bindsym $mod+Tab layout toggle split

bindsym $mod+f fullscreen toggle
bindsym $alt+s floating toggle

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"
set $ws11 "0"

workspace $ws1 output eDP-1
workspace $ws2 output HDMI-1
workspace $ws3 output HDMI-1
workspace $ws4 output HDMI-1
workspace $ws5 output HDMI-1
workspace $ws6 output HDMI-1
workspace $ws7 output HDMI-1
workspace $ws8 output HDMI-1
workspace $ws9 output HDMI-1
workspace $ws10 output HDMI-1
workspace $ws11 output HDMI-1

bindsym $mod+Escape exec pcmanfm

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10
bindsym $alt+Escape workspace number $ws11
workspace_auto_back_and_forth yes

bindsym $mod+Ctrl+1 move container to workspace number $ws1; workspace number $ws1
bindsym $mod+Ctrl+2 move container to workspace number $ws2; workspace number $ws2
bindsym $mod+Ctrl+3 move container to workspace number $ws3; workspace number $ws3
bindsym $mod+Ctrl+4 move container to workspace number $ws4; workspace number $ws4
bindsym $mod+Ctrl+5 move container to workspace number $ws5; workspace number $ws5
bindsym $mod+Ctrl+6 move container to workspace number $ws6; workspace number $ws6
bindsym $mod+Ctrl+7 move container to workspace number $ws7; workspace number $ws7
bindsym $mod+Ctrl+8 move container to workspace number $ws8; workspace number $ws8
bindsym $mod+Ctrl+9 move container to workspace number $ws9; workspace number $ws9
bindsym $mod+Ctrl+0 move container to workspace number $ws10; workspace number $ws10
bindcode $mod+Ctrl+22 move container to workspace number $ws11; workspace number $ws11

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+m exit

hide_edge_borders smart
default_border pixel 2
gaps inner 8
gaps outer 0
smart_gaps off

#                       border  bg      text    indicator child_border
client.focused          #e68070 #e68070 #2b3339 #e68070   #e68070
client.focused_inactive #392b2b #392b2b #a68d8d #392b2b   #392b2b
client.unfocused        #2b3339 #2b3339 #7c6f6f #2b3339   #2b3339
client.urgent           #e67e80 #e67e80 #2b3339 #e67e80   #e67e80

for_window [class="imv"] floating enable 
for_window [class="mpv"] floating enable
for_window [class="cute"] floating enable resize set 800 600
for_window [class="cava"] floating enable resize set 800 600
for_window [class="java"] floating enable resize set 800 600
assign [class="(i?)Spotify"] $ws4
assign [class="(i?)Telegram"] $ws3
assign [title="(a?)Discord"] $ws3

# bindsym $mod+c workspace next
# bindsym $mod+x workspace prev
# bindsym $mod+Ctrl+c move container to workspace next; workspace next
# bindsym $mod+Ctrl+x move container to workspace prev; workspace prev
exec i3-msg restart
